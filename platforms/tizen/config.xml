<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://gorotv.com/goroTV" version="1.0.0" viewmodes="maximized">
    <tizen:application id="x6k9Jp3q1Z.goroTV" package="x6k9Jp3q1Z" required_version="2.3"/>
    <tizen:profile name="tv-samsung"/>
    
    <content src="index.html"/>
    <name>goroTV</name>
    <icon src="icon.png"/>
    <description>goroTV - Plataforma Multiplataforma IPTV para Samsung Smart TV</description>

    <!-- Compatibilidad de resolución de pantalla exigida por Samsung Pre-Test -->
    <feature name="http://tizen.org/feature/screen.size.all"/>

    <!-- Permisos requeridos -->
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>

    <!-- Acceso ilimitado para video streams -->
    <access origin="*" subdomains="true"/>

    <tizen:metadata key="http://samsung.com/tv/metadata/devel.api.version" value="2.4"/>
    <tizen:setting screen-orientation="landscape" context-menu="enable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
